# Torre de Promesa · demo Reflo — copia este archivo a .env.local y llena los valores.
# NUNCA subas .env.local a git (el repo es público).

# ---------------------------------------------------------------------
# A. Variables de la aplicación (también van en Vercel: Production y Preview)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (salta RLS). Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL_CONVERSA=
OPENAI_MODEL_CLASIFICA=

# Waygo: emulador | sandbox
WAYGO_TARGET=
# Emulador local: http://localhost:3000/api/waygo-emu/partner · Sandbox: https://dev-tms-api.waygo.pro/partner
WAYGO_API_BASE_URL=
WAYGO_API_KEY=
WAYGO_WEBHOOK_SECRET=

# Emulador de Waygo
EMU_WAYGO_API_KEY=
EMU_WAYGO_WEBHOOK_SECRET=
# A dónde envía el emulador los webhooks (local: http://localhost:3000/api/webhooks/waygo)
EMU_WAYGO_WEBHOOK_URL=
# Protege /emulador, /api/waygo-emu/admin/*, /api/waygo/* y /api/demo/* (header x-admin-token)
DEMO_ADMIN_TOKEN=

DEMO_CONTROL_GROUP_PCT=
DEMO_CUTOFF_TIME=

# ---------------------------------------------------------------------
# B. Herramientas (solo local / CI; NO van a Vercel)
# ---------------------------------------------------------------------
GITHUB_REPO=
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_SCOPE=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
